# AKR index cache — a rebuildable artifact, never canonical (see D-019).
.akr/cache/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Agent scratch layer — disposable, non-canonical (see docs/01-architecture.md).
.agent/scratch/

# Advisor packets — disposable coordination state describing a workspace at a moment,
# not project truth (D-040, docs/17-advisor-packets.md). A packet is worthless once the
# tree it fingerprints has moved on, and committing one would also commit the preparing
# agent's private worker notes.
.agent/handoffs/

# Rust build output (implementation phases P1+).
/target/
**/*.rs.bk

# `tools/mcp-conformance` is a Cargo project outside the workspace, so the anchored rule
# above never reaches its build directory. Without this line the first local run of
# scripts/verify-mcp-conformance.sh offers eighty crates of build output for commit.
tools/mcp-conformance/target/

# Editor / OS noise
.DS_Store
*.swp
*~
.idea/
.vscode/

# Design-tooling byproducts
__pycache__/
*.pyc

# Agent worktrees. Each is a whole second checkout of this repository; one is never part
# of a commit here, and an interrupted session leaves the directory behind without its
# .git entry, which is what made `tools/check-design.py` read one as part of this tree.
.claude/worktrees/

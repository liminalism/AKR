record akr.papercut.writing-several-evidence-and-lifecycle-records/1 : papercut {
    title "Writing several evidence and lifecycle records repeated full…"
    state superseded
    statement """
        Writing several evidence and lifecycle records repeated full Git-history work and a post-write session reload, turning small ledger mutations into minute-scale operations. Batch Git facts by ledger file, avoid the redundant reload, and provide atomic bulk evidence.
        """
    observed_at git:de899cd260ab7b8f303a53ed5051118f211c2eb9
    author "codex"
    created_at 2026-08-09
}

record akr.papercut.writing-several-evidence-and-lifecycle-records/2 : papercut {
    title "Writing several evidence and lifecycle records repeated full…"
    state withdrawn
    statement """
        Writing several evidence and lifecycle records repeated full Git-history work and a post-write session reload, turning small ledger mutations into minute-scale operations. Batch Git facts by ledger file, avoid the redundant reload, and provide atomic bulk evidence.

        PARTLY RESOLVED in fb3bb92. Atomic bulk evidence exists on both surfaces: `akr evidence
        add-many --from <file>` and `knowledge.evidence_add_many` share one implementation in
        akr-cli and validate the resulting ledger once, so a verification run costs one pipeline
        pass rather than one per record. The other half of this papercut — batching git facts by
        ledger file and dropping the post-write session reload — is a performance claim that has
        not been measured since `Repository::shared` began memoising across handles. Left open
        as a measurement task, not a fix.
        """
    observed_at git:de899cd260ab7b8f303a53ed5051118f211c2eb9
    supersedes [ @akr.papercut.writing-several-evidence-and-lifecycle-records/1 ]
    author "codex"
    created_at 2026-08-09
}

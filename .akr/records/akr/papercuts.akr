record akr.papercut.while-running-the-workspace-suite-on-windows/1 : papercut {
    title "While running the workspace suite on Windows, `akr-cli`'s transcript…"
    state superseded
    statement """
        While running the workspace suite on Windows, `akr-cli`'s transcript harness unconditionally spawned `sh` for its limited `sed` directives and failed with program not found. Implement those fixture rewrites in Rust/PowerShell-independent code or skip them with an explicit platform diagnostic.
        """
    observed_at git:a72ffa4be531adbf3e9abcac9d8fa1717819b2ca
    author "codex"
    created_at 2026-08-14
}

record akr.papercut.while-running-the-workspace-suite-on-windows/2 : papercut {
    title "While running the workspace suite on Windows, `akr-cli`'s transcript…"
    state withdrawn
    statement """
        While running the workspace suite on Windows, `akr-cli`'s transcript harness unconditionally spawned `sh` for its limited `sed` directives and failed with program not found. Implement those fixture rewrites in Rust/PowerShell-independent code or skip them with an explicit platform diagnostic.

        RESOLVED in fb3bb92. The transcript harness implements its one `sed` directive in Rust
        and no longer spawns `sh`. An unrecognised directive fails loudly rather than being
        approximated. crates/akr-cli/tests/support/mod.rs.
        """
    observed_at git:a72ffa4be531adbf3e9abcac9d8fa1717819b2ca
    supersedes [ @akr.papercut.while-running-the-workspace-suite-on-windows/1 ]
    author "codex"
    created_at 2026-08-14
}

record akr.papercut.while-withdrawing-a-collated-master-through/1 : papercut {
    title "While withdrawing a collated master through knowledge.revise, the tool…"
    state superseded
    statement """
        While withdrawing a collated master through knowledge.revise, the tool carried its `collated` string[] slot forward but record::slot_line rendered that slot as a scalar and rejected its own merged payload with `slot collated expects a string`. A collated papercut cannot be revised over MCP until generic string-array slots serialize consistently.
        """
    observed_at git:1414d0107e6bde1dfb7b05911e0be53a15b1b33d
    author "codex"
    created_at 2026-08-23
}


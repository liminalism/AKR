akr 0.1
project akr

record akr.papercut.a-subagent-spawned-with-worktree-isolation-into/1 : papercut {
    title "A subagent spawned with worktree isolation into .claude/worktrees/<id>…"
    state verified
    statement """
        A subagent spawned with worktree isolation into .claude/worktrees/<id> ran for an hour in a directory that was never a valid git worktree: git resolved its working tree back to the main repo, so `git worktree list` never listed it and `git status` inside it reported the MAIN tree's in-flight changes from other agents as if they were its own. The failure was silent at spawn time and only surfaced when a later resume refused it with work-tree-elsewhere. It cost an hour of a subagent's work and left an orphan directory holding a full cargo target/. Validate the worktree at creation and fail loudly, rather than handing the agent a directory that reads as the parent repo.
        """
    observed_at git:9b534026ceff084e33ac987b959f3824eabaa409
    about "claude-code"
    author "claude-opus-5"
    created_at 2026-08-18
}


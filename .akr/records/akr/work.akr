}

record akr.work.revise-repoints-pinned-referrers/1 : work {
    title "Repoint pinned referrers in the same write that revises their target"
    state completed
    scope [
        path "crates/akr-core/src/ops/**",
        path "crates/akr-core/src/validate/**",
        path "docs/05-validation-rules.md",
        path "docs/07-cli.md"
    ]
    intent """
        Revising a record that another live record pins by revision introduces AKR-L021
        on the referrer, and the write is refused because that diagnostic is new
        (D-039). The referrer cannot be moved to n+1 first because n+1 does not exist
        yet. The escape is still a three-write dance: float or drop the pin, revise the
        target, re-pin. A single write that rewrites non-historical pins of the retired
        revision onto the successor would close
        @lege-ecosystem.papercut.healing-an-inherited-akr-t023-on-an-evidence.
        """
    acceptance {
        check historical-pins-stay {
            statement """
                A historical pin (`derived_from`, `supersedes`) of the retired revision
                is left pointing at that revision.
                """
            method command
            command "cargo test -p akr-core --test ops_write"
            verified_by [ @akr.evidence.revise-repoints-pinned-referrers/1 ]
        }
        check same-write-repoint {
            statement """
                Revising a sealed record that a live non-historical relation pins by
                revision updates that pin to the successor in the same atomic write, and
                does not refuse with AKR-L021 on the referrer.
                """
            method command
            command "cargo test -p akr-core --test ops_write"
            verified_by [ @akr.evidence.revise-repoints-pinned-referrers/1 ]
        }
    }
    derived_from [ @akr.papercut.collated-7-papercuts-from-lege-ecosystem-jpegxl ]
}


record akr.work.revise-lifecycle-semantics/1 : work {
    title "Preserve requested lifecycle state across revisions"
    state completed
    scope [
        path "crates/akr-cli/src/write.rs",
        path "crates/akr-core/src/ops/**",
        path "crates/akr-mcp/src/tools.rs",
        path "crates/akr-mcp/tests/writes.rs",
        path "docs/07-cli.md",
        path "docs/08-mcp.md"
    ]
    intent """
        Make sealed-record revision behavior explicit and correct: a requested state must land
        on the new revision, while a content-only revision must follow one documented state
        policy consistently across CLI and MCP instead of accidentally returning accepted
        records to `proposed`.
        """
    acceptance {
        check content-state-policy {
            statement """
                Content-only revisions of sealed records preserve or deliberately reset lifecycle state according to one documented, tested policy.
                """
            method command
            verified_by [ @akr.evidence.papercut-reconciliation-suite/1 ]
        }
        check ready-to-active {
            statement """
                knowledge.revise on a ready planning head with state active creates a new active head and retires the old revision atomically.
                """
            method command
            verified_by [ @akr.evidence.papercut-reconciliation-suite/1 ]
        }
        check surfaces-agree {
            statement """
                CLI and MCP lifecycle revision tests agree on the new revision's state and returned revision identifier.
                """
            method command
            verified_by [ @akr.evidence.papercut-reconciliation-suite/1 ]
        }
    }

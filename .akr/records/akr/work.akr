record akr.work.mcp-budget-and-instrumentation/1 : work {
    title "Bound and instrument the MCP surface"
    state completed
    intent """
        Take the token-reduction advice in sources/context-reduction.md as far as the MCP
        surface itself: detail levels, per-tool output budgets, a read-only surface, per-call
        accounting, and a named diagnostic for a server older than its workspace.
        """
    acceptance {
        check accounting {
            statement """
                akr-mcp --accounting appends one JSON line per call carrying sizes, estimated
                tokens, duration and whether the budget withheld the result.
                """
            method command
            command "cargo test -p akr-mcp"
            verified_by [
                @akr.evidence.knowledge-provenance-lifecycle-suite/1,
                @akr.evidence.mcp-budget-and-skew-suite
            ]
        }
        check budgets-withhold {
            statement """
                A result over its per-tool hard limit is withheld with its counts and a
                ready-made narrower call, never silently shortened, and both halves of the
                payload count towards the limit.
                """
            method command
            command "cargo test -p akr-mcp"
            verified_by [
                @akr.evidence.knowledge-provenance-lifecycle-suite/1,
                @akr.evidence.mcp-budget-and-skew-suite
            ]
        }
        check detail-levels {
            statement """
                knowledge.get takes summary, body or canonical, and canonical source text is an
                explicit request rather than the default payload.
                """
            method command
            command "cargo test -p akr-mcp"
            verified_by [
                @akr.evidence.knowledge-provenance-lifecycle-suite/1,
                @akr.evidence.mcp-budget-and-skew-suite
            ]
        }
        check read-surface {
            statement """
                akr-mcp --surface read lists only the tools that answer questions.
                """
            method observation
            verified_by [
                @akr.evidence.knowledge-provenance-lifecycle-suite/1,
                @akr.evidence.workspace-green-2026-08-08
            ]
        }
        check skew-named {
            statement """
                A server whose vocabulary disagrees with the workspace lock reports AKR-X042 on
                a failing call, naming the reinstall and the reconnect.
                """
            method command
            command "cargo test -p akr-mcp"
            verified_by [
                @akr.evidence.knowledge-provenance-lifecycle-suite/1,
                @akr.evidence.mcp-budget-and-skew-suite
            ]
        }
    }
    implements [ @akr.decision.mcp-budgeted-and-instrumented ]
}

record akr.work.mcp-handshake-and-collated-papercuts/1 : work {
    title "Make AKR MCP handshake with current clients and fix collated papercuts"
    state superseded
    intent """
        Maintain current MCP client compatibility and absorb every AKR papercut surfaced by subject-scoped collation. The 2026-08-23 pass includes blank-line citation normalization, exact per-kind and scope authoring schemas, normative-only topic preflight, OR-ranked natural-language search, kept-scratch evidence recognition, terminal collation dedup, and the already implemented scratch command and installed-client handshake protections.
        """
    target 2026-08-16
    acceptance {
        check collated-cli-mcp-papercuts {
            statement """
                The earlier collated AKR papercuts for get slot names, start namespaces and budget, change status, empty-repo observed_at, --from help, enum methods, and MCP transport have regression coverage.
                """
            method command
            command "cargo test --workspace --all-targets"
        }
        check current-collated-papercuts {
            statement """
                All AKR and akr-mcp papercuts returned by the 2026-08-23 collate pass are either covered by regression tests or dispositioned as an installed-version rollout concern; a second dry run reports nothing new.
                """
            method command
            command "cargo test --workspace --all-targets"
        }
        check handshake-speaks-current-clients {
            statement """
                Initialize echoes current supported protocol versions and the stdio server answers both NDJSON and Content-Length framed requests with a non-empty tools/list.
                """
            method command
            command "cargo test -p akr-mcp"
        }
    }
    derived_from [
        @akr.papercut.collated-10-papercuts-from-evidence-intake-2/1,
        @akr.papercut.collated-18-papercuts-from-evidence-intake/1
    ]

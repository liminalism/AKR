record akr.work.sister-papercut-fixes/1 : work {
    title "Work the sister-project papercuts that are AKR's to fix"
    state completed
    intent """
        Take the eighteen collated frictions, separate the ones that are AKR's from the ones
        that belong to the reporting project, and fix AKR's.
        """
    acceptance {
        check ancestry-batched {
            statement """
                Ancestry costs two git processes rather than one per evidence citation.
                """
            method command
            command "cargo test -p akr-core --test git_queries --test freshness"
            verified_by [
                @akr.evidence.knowledge-provenance-lifecycle-suite/1,
                @akr.evidence.sister-papercut-fixes
            ]
        }
        check fts-escaping {
            statement """
                The three queries that failed with fts5 errors in the field return results, and
                raw FTS5 stays reachable behind an explicit flag.
                """
            method command
            command "cargo test -p akr-cli --test search"
            verified_by [
                @akr.evidence.knowledge-provenance-lifecycle-suite/1,
                @akr.evidence.sister-papercut-fixes
            ]
        }
        check stale-reports-verified {
            statement """
                The AKR-E003 view-renderer reports from bpg-rs and jpegXL-rs are confirmed
                stale: all seven views render.
                """
            method observation
            verified_by [
                @akr.evidence.knowledge-provenance-lifecycle-suite/1,
                @akr.evidence.sister-papercut-fixes
            ]
        }
        check strict-and-dirty {
            statement """
                AKR-G004 alone no longer fails strict mode, so a clean check is reachable
                mid-task.
                """
            method observation
            verified_by [
                @akr.evidence.knowledge-provenance-lifecycle-suite/1,
                @akr.evidence.sister-papercut-fixes
            ]
        }
    }
    implements [ @akr.decision.query-words-dirty-tree-ancestry ]
}

record akr.work.three-writes-that-could-not-be-told-apart/1 : work {
    title "Three writes that could not be told apart from the thing they were not"
    state completed
    scope [
        path "crates/akr-cli/src/write.rs",
        path "crates/akr-core/src/freshness/glob.rs",
        path "crates/akr-core/src/ops/**"
    ]
    intent """
        Three small defects with one shape between them, all landed 2026-09-08.

        A PROPOSE OR REVISE NAMING A COMMIT THE REPOSITORY LACKS. `akr evidence add` has refused an
        absent `observed_at` since 0.4; `propose` and `revise` did not, so a well-formed 40-hex string
        naming no commit landed without a word. It was never unfalsifiable — the next `akr check`
        catches it as AKR-G011, a hard error under `--strict` — but it surfaced on a write the author
        had already moved on from, which is the expensive kind of correct. Fixed by giving all three
        write paths the same `ensure_commits_exist`, driven by a new `commits_named_by()` that walks a
        record's content slots for commit values rather than hardcoding `observed_at`.

        A COMPLETE WITH NOTHING TO VERIFY. V-020 is satisfied vacuously by a record with no acceptance
        checks, so `akr complete` accepts it and the result is indistinguishable from a completion that
        was verified. Not a refusal — small work legitimately carries no acceptance — but the reader is
        entitled to know which of the two they are looking at, and the author is the right person to
        tell at the moment of the decision. `complete` now notes: "completed with no acceptance checks;
        nothing was verified".

        A BARE DIRECTORY SCOPE MATCHING NOTHING. `glob::matches` compared a pattern against file paths,
        so `tools` was never equal to `tools/build.py` and a scope written `path "tools/"` matched
        nothing at all — while `git ls-files -- ':(glob)tools/'` returned twenty-five files. The
        author was then told the path "moved or was deleted" about a directory sitting right there,
        which is worse than a miscount because it sends them looking for a deletion that never happened.
        `matches` now also succeeds on a directory prefix — every pattern segment consumed against the
        head of the target with segments left over — restricted to patterns containing no `**`, since
        `a/**` already expresses the subtree and keeps its exact documented semantics including matching
        `a` itself.

        The shape they share is the one this pass kept finding: each produced an outcome a reader could
        not tell apart from the thing it was not. A silent write from a mistaken one; a vacuous
        completion from a verified one; a directory that does not exist from one that does. See
        @akr.decision.a-check-says-what-it-looked-at.

        One consequence worth carrying forward: some share of the 2026-09-08 census's 119
        DELETED/NEVER-EXISTED classifications may have been this glob bug rather than deletion, so that
        figure should be re-derived rather than cited.
        """
    acceptance {
        check a-directory-scope-matches-what-is-under-it {
            statement """
                `tools/`, `tools`, `tools/**`, `tools/*` and `tools/build.py` all match a tracked file under tools/, and a directory that really is absent still raises AKR-G023.
                """
            method command
            command "cargo test -p akr-core --test freshness a_directory_scope_matches_what_is_under_it"
            verified_by [ @akr.evidence.six-point-of-failure-fixes-20260908/1 ]
        }
        check a-vacuous-completion-says-so {
            statement """
                Completing a record with no acceptance checks emits a note saying nothing was verified.
                """
            method observation
            verified_by [ @akr.evidence.six-point-of-failure-fixes-20260908/1 ]
        }
        check the-write-paths-agree-on-commits {
            statement """
                propose, revise and evidence add all refuse an observed_at commit the repository does not have, at the write.
                """
            method command
            command "cargo test -p akr-cli --test writes"
            verified_by [ @akr.evidence.six-point-of-failure-fixes-20260908/1 ]
        }
    }
}

record akr.work.what-an-unversioned-relation-means/1 : work {
    title "A supersedes edge records a replacement and does not perform it, and a resolves edge is historical"
    state superseded
    scope [
        path "crates/akr-core/src/model/**",
        path "crates/akr-core/src/ops/**",
        path "crates/akr-core/src/validate/**",
        path "docs/04-references-and-versioning.md"
    ]
    intent """
        CORRECTED 2026-09-08. The first version of this record claimed AKR has no settled answer to
        what an unversioned reference means, and that A12 and A13 were one defect in two directions
        that had to be fixed together. Both claims are wrong and the correction matters more than the
        original.

        THE DEFINITION WAS NEVER MISSING. D-009 states it, uniformly across all four reference forms
        with no per-slot variation: `@key` is the current head and resolves to whichever revision is
        live at build time; `@key/2` is pinned and resolves to revision 2, always. The model encodes it
        as RefMode::CurrentHead and RefMode::Pinned. docs/04 4.1's "supersession is always pinned" sits
        under D-009's explicit "guidance, not enforced" clause and does not override it. There is no
        D-record to write; the answer is in force and outranks the numbered specs.

        AND THE TWO ARE NOT ONE DEFECT. They share a subsystem, not a root cause: one is a graph edge
        that does nothing, the other is an exemption list with a hole in it. The correct diff is
        asymmetric, and the instinct to unify them is exactly what would have produced a symmetric patch
        that fixed neither properly.

        A12, AND THE PROBE THAT NARROWS IT FURTHER. The reported symptom was that an unversioned
        cross-key `supersedes` fails to retire its target. A throwaway workspace on 2026-09-08 tested
        both forms side by side: one observation superseded by a successor naming it WITHOUT a revision,
        one by a successor naming it WITH one. Both targets stayed `verified`; `akr why-current`
        resolved both as LIVE; `akr check` said nothing about either.

        So the defect is not about pinning at all. A cross-key `supersedes` edge NEVER retires its
        target, in either form. Within one key, supersession is the revision chain and `head()` computes
        it; across keys it is not computed anywhere, because `akr supersede` moves the target's state
        explicitly and the edge is documentation of that act. A hand-authored cross-key edge therefore
        records a replacement that never happened, and the openarc observation that kept re-entering the
        review queue carrying such an edge would have done so identically had its author added the
        revision suffix. Any fix framed as "name the missing suffix" would tell the author to write
        something that changes nothing.

        What is not legal under D-009 whichever way it is fixed is the status quo: accept the edge,
        store it, and silently do nothing. The silence is the defect. Fixed by extending V-006 — a live
        record whose `supersedes` names a still-live record in another key now raises AKR-L021, saying
        the edge records the replacement rather than performing it, and naming `akr supersede` or an
        explicit state move as the two things that do. It is part of V-006 rather than a rule of its
        own because "terminal records are cited, not built on" and "an edge claiming a record is
        terminal must be telling the truth" are the same rule read from either end.

        A13 IS AN EXEMPTION-LIST BUG AND NOTHING MORE. `@key/2` is legal in every slot under D-009.
        AKR-L021 is V-006, which forbids a LIVE record from pinning a TERMINAL target, with exemptions
        for the cases where the target reaching a terminal state is the point rather than a problem —
        `after` and `blocks` and `verified_by` unconditionally, `depends_on` when the target completed,
        `part_of` when it completed or was dispositioned. A `resolves` edge naming the question it
        answers is inherently historical, and a resolved question is the expected end state of resolving
        it: resolution satisfies a question exactly as completion satisfies a prerequisite. The hole
        showed as a contradiction between two rules — V-011 demands a `resolves` edge before a question
        may be resolved, and V-006 then rejected the pinned form of the edge it had demanded, with the
        error landing on the answering record rather than on the write the author was making. One line
        added to the exemption list, alongside the two that were already there for the same reason.

        A11 WAS FIXED AS A MESSAGE, DELIBERATELY, AND THIS IS THE JUDGEMENT MOST OPEN TO CHALLENGE.
        `akr supersede <old> --with <new>` refuses a sealed replacement because it edits the replacement
        in place, which D-015 permits only while it is `proposed`. That requirement is deliberate and
        documented: the replacement is proposed separately so its body, title and scope can be reviewed
        before an atomic graph transition. Teaching the operation to cut a revision of a sealed
        replacement instead would mean building a record carrying both its own same-key chain edge and
        the cross-key one, retiring two heads in one write — real surgery on the write path, for a case
        where a correct two-command sequence already exists. What was actually broken was that the
        sequence is undiscoverable and the obvious workaround is lossy: `akr revise <old> --state
        superseded` retires the old head and records no edge to the successor at all. The refusal now
        prints the sequence that works and says plainly that the workaround loses the relationship.

        ONE TENSION LEFT STANDING, and it should be written down rather than re-derived. D-009 says
        pinning is "guidance, not enforced", while V-006 does enforce something about pinned references
        — that a live record may not pin a terminal target. Both are defensible and they are not quite
        the same statement, since D-009 governs what a reference MEANS and V-006 governs where one may
        be USED. But nothing says so, and the next agent to read them together will re-run this
        argument. Whichever is authoritative should be stated in docs/04.
        """
    acceptance {
        check a-resolves-edge-is-historical {
            statement """
                An answering record may name the question it resolved, pinned, without AKR-L021 — resolution satisfies a question as completion satisfies a prerequisite.
                """
            method command
            command "cargo test -p akr-core --test v_rules v006_passes_for_resolves_pointing_at_the_question_it_resolved"
            verified_by [ @akr.evidence.relation-fixes-20260908/1 ]
        }
        check a-supersedes-edge-that-did-nothing-says-so {
            statement """
                A live record whose `supersedes` names a still-live record in another key raises AKR-L021, in both the pinned and the unversioned form, and stays silent once the target is retired.
                """
            method command
            command "cargo test -p akr-core --test v_rules v006_reports_a_supersedes_edge_that_has_not_superseded_anything"
            verified_by [ @akr.evidence.relation-fixes-20260908/1 ]
        }
        check the-sealed-supersede-refusal-names-the-sequence {
            statement """
                `akr supersede <old> --with <sealed new>` prints the two-command sequence that works and says that retiring the old head alone records no edge to the successor.
                """
            method observation
            verified_by [ @akr.evidence.relation-fixes-20260908/1 ]
        }
    }
}

record akr.work.what-an-unversioned-relation-means/2 : work {
    title "A supersedes edge records a replacement and does not perform it, and a resolves edge is historical"
    state completed
    scope [
        path "crates/akr-core/src/model/**",
        path "crates/akr-core/src/ops/**",
        path "crates/akr-core/src/validate/**",
        path "docs/04-references-and-versioning.md"
    ]
    intent """
        CORRECTED 2026-09-08. The first version of this record claimed AKR has no settled answer to
        what an unversioned reference means, and that A12 and A13 were one defect in two directions
        that had to be fixed together. Both claims are wrong and the correction matters more than the
        original.

        THE DEFINITION WAS NEVER MISSING. D-009 states it, uniformly across all four reference forms
        with no per-slot variation: `@key` is the current head and resolves to whichever revision is
        live at build time; `@key/2` is pinned and resolves to revision 2, always. The model encodes it
        as RefMode::CurrentHead and RefMode::Pinned. docs/04 4.1's "supersession is always pinned" sits
        under D-009's explicit "guidance, not enforced" clause and does not override it. There is no
        D-record to write; the answer is in force and outranks the numbered specs.

        AND THE TWO ARE NOT ONE DEFECT. They share a subsystem, not a root cause: one is a graph edge
        that does nothing, the other is an exemption list with a hole in it. The correct diff is
        asymmetric, and the instinct to unify them is exactly what would have produced a symmetric patch
        that fixed neither properly.

        A12, AND THE PROBE THAT NARROWS IT FURTHER. The reported symptom was that an unversioned
        cross-key `supersedes` fails to retire its target. A throwaway workspace on 2026-09-08 tested
        both forms side by side: one observation superseded by a successor naming it WITHOUT a revision,
        one by a successor naming it WITH one. Both targets stayed `verified`; `akr why-current`
        resolved both as LIVE; `akr check` said nothing about either.

        So the defect is not about pinning at all. A cross-key `supersedes` edge NEVER retires its
        target, in either form. Within one key, supersession is the revision chain and `head()` computes
        it; across keys it is not computed anywhere, because `akr supersede` moves the target's state
        explicitly and the edge is documentation of that act. A hand-authored cross-key edge therefore
        records a replacement that never happened, and the openarc observation that kept re-entering the
        review queue carrying such an edge would have done so identically had its author added the
        revision suffix. Any fix framed as "name the missing suffix" would tell the author to write
        something that changes nothing.

        What is not legal under D-009 whichever way it is fixed is the status quo: accept the edge,
        store it, and silently do nothing. The silence is the defect. Fixed by extending V-006 — a live
        record whose `supersedes` names a still-live record in another key now raises AKR-L021, saying
        the edge records the replacement rather than performing it, and naming `akr supersede` or an
        explicit state move as the two things that do. It is part of V-006 rather than a rule of its
        own because "terminal records are cited, not built on" and "an edge claiming a record is
        terminal must be telling the truth" are the same rule read from either end.

        A13 IS AN EXEMPTION-LIST BUG AND NOTHING MORE. `@key/2` is legal in every slot under D-009.
        AKR-L021 is V-006, which forbids a LIVE record from pinning a TERMINAL target, with exemptions
        for the cases where the target reaching a terminal state is the point rather than a problem —
        `after` and `blocks` and `verified_by` unconditionally, `depends_on` when the target completed,
        `part_of` when it completed or was dispositioned. A `resolves` edge naming the question it
        answers is inherently historical, and a resolved question is the expected end state of resolving
        it: resolution satisfies a question exactly as completion satisfies a prerequisite. The hole
        showed as a contradiction between two rules — V-011 demands a `resolves` edge before a question
        may be resolved, and V-006 then rejected the pinned form of the edge it had demanded, with the
        error landing on the answering record rather than on the write the author was making. One line
        added to the exemption list, alongside the two that were already there for the same reason.

        A11 WAS FIXED AS A MESSAGE, DELIBERATELY, AND THIS IS THE JUDGEMENT MOST OPEN TO CHALLENGE.
        `akr supersede <old> --with <new>` refuses a sealed replacement because it edits the replacement
        in place, which D-015 permits only while it is `proposed`. That requirement is deliberate and
        documented: the replacement is proposed separately so its body, title and scope can be reviewed
        before an atomic graph transition. Teaching the operation to cut a revision of a sealed
        replacement instead would mean building a record carrying both its own same-key chain edge and
        the cross-key one, retiring two heads in one write — real surgery on the write path, for a case
        where a correct two-command sequence already exists. What was actually broken was that the
        sequence is undiscoverable and the obvious workaround is lossy: `akr revise <old> --state
        superseded` retires the old head and records no edge to the successor at all. The refusal now
        prints the sequence that works and says plainly that the workaround loses the relationship.

        ONE TENSION LEFT STANDING, and it should be written down rather than re-derived. D-009 says
        pinning is "guidance, not enforced", while V-006 does enforce something about pinned references
        — that a live record may not pin a terminal target. Both are defensible and they are not quite
        the same statement, since D-009 governs what a reference MEANS and V-006 governs where one may
        be USED. But nothing says so, and the next agent to read them together will re-run this
        argument. Whichever is authoritative should be stated in docs/04.
        """
    note """
        Closed 2026-09-08 after review by a second agent, which changed the design twice and both times
        for the better.

        It killed the D-record this work was originally scoped around: D-009 already defines what an
        unversioned reference means, uniformly, and my claim that the definition was missing was simply
        wrong. It also rejected my framing that A12 and A13 were one defect needing a symmetric fix; the
        correct diff is asymmetric, one validation exemption and one new check, and I had built it that
        way before the review arrived but for weaker reasons than the ones it supplied.

        Then it caught a real bug in the landed exemption, and the reason it was not caught here is the
        lesson. Exempting `Resolves` at a `Resolved` target passes every test and fails every user,
        because resolving a question creates a revision — /2 resolved, /1 superseded — so the pin the
        author writes lands on the superseded revision. The tests passed because `akr revise`
        auto-repoints live pins and had rewritten `@q/1` to `@q/2` before validation ever ran. Green
        where exercised, broken where a user goes: the same shape as the AKR-G021 that passed its unit
        test and could not reach a user, on the same day.

        And it found the justification for refusing the unversioned `supersedes` that neither of us had.
        Not that D-009 needs narrowing, but that `Supersedes` is already classed historical in AKR's own
        model while an unversioned reference is forward-tracking — so the form is incoherent in the
        project's own terms and D-044 only makes the tool agree with a sentence docs/04 had already
        written. It also measured the migration and scoped the rule to `supersedes` alone: nine edges
        against 510 unversioned `derived_from`, which is @akr.work.provenance-edges-that-follow-their-target
        and must not be bolted onto this.

        The two mechanisms are orthogonal and both shipped: D-044's refusal stops an edge re-aiming
        later, and V-006's warning catches an edge that was inert from the day it was written. Each
        found a real defect in a ledger that had been reporting clean.
        """
    acceptance {
        check a-resolves-edge-is-historical {
            statement """
                An answering record may pin the question it resolved, whether that revision is `resolved` or the `superseded` one that was open when the answer was written.
                """
            method command
            command "cargo test -p akr-core --test v_rules v006_passes_for_resolves"
            verified_by [ @akr.evidence.d044-and-the-resolves-exemption-20260908/1 ]
        }
        check a-supersedes-edge-that-did-nothing-says-so {
            statement """
                A live record whose `supersedes` names a still-live record in another key raises AKR-L021, and stays silent once the target is retired.
                """
            method command
            command "cargo test -p akr-core --test v_rules v006_reports_a_supersedes_edge_that_has_not_superseded_anything"
            verified_by [ @akr.evidence.relation-fixes-20260908/1 ]
        }
        check an-unversioned-supersedes-is-refused {
            statement """
                An unversioned cross-key `supersedes` is AKR-L021; the pinned form at a retired target is clean; the same-key revision chain is untouched.
                """
            method command
            command "cargo test -p akr-core --test v_rules v006_refuses_an_unversioned_supersedes"
            verified_by [ @akr.evidence.d044-and-the-resolves-exemption-20260908/1 ]
        }
        check the-sealed-supersede-refusal-names-the-sequence {
            statement """
                `akr supersede <old> --with <sealed new>` prints the two-command sequence that works and says that retiring the old head alone records no edge to the successor.
                """
            method observation
            verified_by [ @akr.evidence.relation-fixes-20260908/1 ]
        }
    }
    supersedes [ @akr.work.what-an-unversioned-relation-means/1 ]
}

record akr.work.windows-linux-certification/1 : work {
    title "Certify Windows and Linux GUI builds"
    state proposed
    scope [ path ".github/**", path "crates/akr-gui/**" ]
    intent """
        Provide CI build and deterministic software-presenter test coverage for the native AKR GUI on Windows and Linux.
        """
    acceptance {
        check platform-ci {
            statement """
                Windows and Linux CI build, tests, and smoke checks pass for akr-gui.
                """
            method observation
        }
    }
    part_of [ @akr.milestone.human-record-review/1 ]
}

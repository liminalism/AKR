akr 0.1
project akr

record akr.work.advisor-packet-handoff/1 : work {
    title "Give AKR a formal worker-to-advisor handoff"
    state proposed
    scope [
        path "crates/akr-cli/src/handoff/**",
        path "crates/akr-mcp/src/**",
        path "docs/17-advisor-packets.md",
        path "scripts/agent-section.md"
    ]
    intent """
        Make handing a task to a second model a first-class, addressable AKR operation rather than a hand-written summary. The packet separates administrative fact, which the preparing agent may compress, from worker interpretation, which it may record but not substitute for the problem; the interpretation is withheld until the advisor has reviewed independently, and the reveal is recorded so that independence is knowable afterwards. Delivered as akr handoff create/list/open/expand/reveal/verify/discard, the matching knowledge.handoff_* MCP tools, a workspace fingerprint that reports exact or drifted, and the agent guidance that makes call an advisor mean prepare a packet.
        """
    note """
        Requested with a design brief that identified the failure mode directly: a summary handoff turns the preparing agent into a perceptual bottleneck, so the receiving model must retain independent discovery authority. Recorded as D-040.
        """
    acceptance {
        check blind-read-holds {
            statement """
                akr handoff open and knowledge.handoff_open render the factual layer and leak no worker note; reveal releases them and records that it happened.
                """
            method command
            command "cargo test -p akr-cli --test advisor_packet"
        }
        check design-set-coherent {
            statement """
                The spec set still coheres with D-040, docs/17 and AKR-C043 in it, and the whole suite passes.
                """
            method command
            command "python tools/check-design.py && cargo test"
        }
        check drift-is-reported-not-fatal {
            statement """
                A fresh packet verifies as exact, an edited tree verifies as drifted and names what moved, and neither changes the exit status.
                """
            method command
            command "cargo test -p akr-cli --test advisor_packet a_fresh_packet_is_exact_and_an_edited_tree_drifts"
        }
        check envelope-stays-project-wide {
            statement """
                A packet's search envelope defaults to the whole project rather than to what the preparing agent examined.
                """
            method command
            command "cargo test -p akr-cli --test advisor_packet the_envelope_defaults_to_the_whole_project"
        }
        check surfaces-agree {
            statement """
                knowledge.handoff_open and akr handoff open produce an identical result object, and opening over MCP does not stamp the packet.
                """
            method command
            command "cargo test -p akr-mcp --test differential an_advisor_packet"
        }
    }
    author "GitHub Uploader"
}

record akr.work.authoring-contracts/1 : work {
    title "Make AKR authoring contracts discoverable before writes"
    state completed
    scope [
        path "crates/akr-cli/src/args.rs",
        path "crates/akr-cli/src/write.rs",
        path "crates/akr-core/src/validate/**",
        path "crates/akr-mcp/src/record.rs",
        path "crates/akr-mcp/src/schema.rs",
        path "docs/**",
        path "spec/**"
    ]
    intent """
        Make CLI help, MCP schemas, and write diagnostics expose the actual per-kind slot and
        relation contract, typed commit fields, namespace requirements, accepted `--from`
        shape, lock-refresh next step, and scope-glob mistakes before an agent has to learn
        them through repeated rejected or silently ineffective writes.
        """
    acceptance {
        check scope-sanity {
            statement """
                A malformed path-prefix scope or a scope glob matching no tracked path produces an actionable authoring diagnostic.
                """
            method command
            verified_by [ @akr.evidence.papercut-reconciliation-suite/1 ]
        }
        check typed-kind-contract {
            statement """
                Explain, MCP schemas, and AKR-T002/V-005 diagnostics identify legal per-kind slots and relations and show commit-typed fields as full Git commits.
                """
            method command
            verified_by [ @akr.evidence.papercut-reconciliation-suite/1 ]
        }
        check workflow-remedies {
            statement """
                Papercut namespace ambiguity, stale-lock responses, CLI/MCP search naming, and propose --from help each state the exact accepted form or next command.
                """
            method command
            verified_by [ @akr.evidence.papercut-reconciliation-suite/1 ]
        }
    }
    derived_from [ @akr.papercut.collated-18-papercuts-from-evidence-intake/1 ]
}

record akr.work.change-delta-counts-the-index/1 : work {
    title "Report what a change touches, not what the repository tracks"
    state completed
    scope [
        path "crates/akr-cli/src/change.rs",
        path "crates/akr-core/src/change/mod.rs",
        path "crates/akr-core/src/git/mod.rs"
    ]
    intent """
        `akr change prepare --staged` read `git ls-files --stage`, the whole index, where it meant the paths staged against HEAD. So it reported "code 388 files" for a change that touched twelve, and — worse than the wrong number — refused a ledger-only commit with AKR-C032 for touching implementation files it had not touched, forcing --untracked-reason onto every commit that only writes records. The whole index is the right input for the implementation digest and for reading staged .akr blobs; it is the wrong input for `SemanticDelta::code` and `ledger_files`, which are that change's contents. Give the delta the diff against HEAD instead. Reported as akr.papercut.akr-change-prepare-staged-reports-code-n-files.
        """
    acceptance {
        check digest-still-spans-the-tree {
            statement """
                The implementation digest still covers every tracked implementation file, so a tree that moves elsewhere still invalidates a preparation.
                """
            method command
            command "cargo test -p akr-cli --test change_protocol"
            verified_by [ @akr.evidence.change-delta-ledger-only/1 ]
        }
        check ledger-only-change-is-not-code {
            statement """
                A change that stages only .akr and generated views reports zero code files and prepares without --primary or --untracked-reason.
                """
            method command
            command "akr change prepare --staged"
            verified_by [ @akr.evidence.change-delta-in-this-repo/1 ]
        }
        check workspace-green {
            statement """
                The whole workspace builds and tests clean, clippy is silent, formatting is clean, and the design set is coherent.
                """
            method command
            command "cargo test && cargo clippy --all-targets && cargo fmt --all -- --check && python3 tools/check-design.py"
            verified_by [ @akr.evidence.change-delta-green/1 ]
        }
    }
}

record akr.work.commit-rewrite-equivalence/1 : work {
    title "Preserve freshness across declared Git history rewrites"
    state superseded
    scope [
        path "crates/akr-cli/src/session.rs",
        path "crates/akr-core/src/git/**",
        path "crates/akr-core/tests/**",
        path "docs/10-freshness-and-git.md"
    ]
    intent """
        Let a repository explicitly map an unreachable pre-rewrite commit to its reviewed replacement. Git validation remains strict: the replacement must exist and be reachable from the resolved head, and freshness and acceptance calculations continue from that replacement rather than suppressing ancestry diagnostics.
        """
    acceptance {
        check mapped-commit-remains-validated {
            statement """
                A declared replacement removes G012 only when the replacement exists and is an ancestor of the resolved head.
                """
            method command
            command "cargo test -p akr-core git_queries freshness"
        }
        check unmapped-divergence-still-reported {
            statement """
                An undeclared divergent observed_at commit still produces AKR-G012.
                """
            method command
            command "cargo test -p akr-core git_queries freshness"
        }
    }
}


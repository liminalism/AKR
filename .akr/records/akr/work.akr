record akr.work.mcp-transport-reliability/1 : work {
    title "Make MCP sessions survive sustained mixed AKR use"
    state completed
    scope [ path "crates/akr-mcp/**", path "docs/08-mcp.md" ]
    intent """
        Reproduce and eliminate the recurrent sister-project `Transport closed` failures seen
        after successful reads and writes. Cover the installed connector process, not only an
        in-memory protocol loop, and preserve a useful structured failure if the server must
        terminate.
        """
    acceptance {
        check installed-session-stress {
            statement """
                An installed MCP subprocess survives a sustained mixed sequence of explain, context, revise, validate, and papercut calls including rejected requests.
                """
            method command
            verified_by [ @akr.evidence.papercut-reconciliation-suite/1 ]
        }
        check sister-reproduction {
            statement """
                The reported multi-write failure pattern is either reproduced and fixed or ruled out with captured connector-level evidence.
                """
            method manual
            verified_by [ @akr.evidence.mcp-sister-transport-reproduction/1 ]
        }
        check termination-diagnostic {
            statement """
                Any intentional MCP termination is reported with a durable diagnostic and reconnect remedy rather than an unexplained closed transport.
                """
            method command
            verified_by [ @akr.evidence.papercut-reconciliation-suite/1 ]
        }
    }
    derived_from [ @akr.papercut.collated-18-papercuts-from-evidence-intake/1 ]
}


        """
    note """
        Requested with a design brief that identified the failure mode directly: a summary handoff turns the preparing agent into a perceptual bottleneck, so the receiving model must retain independent discovery authority. Recorded as D-040.

        REPOINTED 2026-09-08. Every command check named something that no longer existed and therefore passed without running anything: the test file moved from crates/akr-cli/tests/advisor_packet.rs to crates/akr-cli/tests/handoff.rs, a_fresh_packet_is_exact_and_an_edited_tree_drifts became a_fresh_session_is_exact_and_an_edited_tree_drifts, the_envelope_defaults_to_the_whole_project became the_scope_defaults_to_the_whole_project, and the MCP differential's an_advisor_packet became a_handoff_opens_the_same_way_from_either_surface. The scope path docs/17-advisor-packets.md was corrected to docs/17-handoff.md. Re-run and re-completed against @akr.evidence.advisor-packet-gates-repointed-20260908.

        This record was found by the fix it motivated: extending AKR-G023 to completed records surfaced the dead scope path, and reading the record to fix that showed every gate under it was vacuous. The tool's own ledger held a completed record whose acceptance could not fail.
        """
    acceptance {
        check blind-read-holds {
            statement """
                akr handoff open and knowledge.handoff_open render the factual layer and leak no worker note; reveal releases them and records that it happened.
                """
            method command
            command "cargo test -p akr-cli --test handoff"
            verified_by [ @akr.evidence.advisor-packet-gates-repointed-20260908/1 ]
        }
        check design-set-coherent {
            statement """
                The spec set still coheres with D-040, docs/17 and AKR-C043 in it, and the library suites pass.
                """
            method command
            command "python3 tools/check-design.py && cargo test -p akr-core -p akr-cli -p akr-mcp"
            verified_by [ @akr.evidence.advisor-packet-gates-repointed-20260908/1 ]
        }
        check drift-is-reported-not-fatal {
            statement """
                A fresh packet verifies as exact, an edited tree verifies as drifted and names what moved, and neither changes the exit status.
                """
            method command
            command "cargo test -p akr-cli --test handoff a_fresh_session_is_exact_and_an_edited_tree_drifts"
            verified_by [ @akr.evidence.advisor-packet-gates-repointed-20260908/1 ]
        }
        check envelope-stays-project-wide {
            statement """
                A packet's search envelope defaults to the whole project rather than to what the preparing agent examined.
                """
            method command
            command "cargo test -p akr-cli --test handoff the_scope_defaults_to_the_whole_project"
            verified_by [ @akr.evidence.advisor-packet-gates-repointed-20260908/1 ]
        }
        check surfaces-agree {
            statement """
                knowledge.handoff_open and akr handoff open produce an identical result object, and opening over MCP does not stamp the packet.
                """
            method command
            command "cargo test -p akr-mcp --test differential a_handoff_opens_the_same_way_from_either_surface"
            verified_by [ @akr.evidence.advisor-packet-gates-repointed-20260908/1 ]
        }
    }
    supersedes [ @akr.work.advisor-packet-handoff/1 ]
    author "GitHub Uploader"
}


record akr.work.search-auto-refreshes-stale-index/1 : work {
    title "Refresh stale search indexes before returning results"
    state completed
    scope [
        path "crates/akr-cli/src/**",
        path "crates/akr-cli/tests/**",
        path "crates/akr-mcp/**",
        path "docs/**"
    ]
    intent """
        Make akr search and knowledge.search rebuild a stale or missing disposable index before querying, unless --no-rebuild explicitly forbids cache writes, so search never presents known-old results or requires a human build between agent writes.
        """
    acceptance {
        check fresh-after-write {
            statement """
                A search immediately after a ledger write rebuilds the cache and returns current indexed results without a stale warning.
                """
            method command
            command "cargo test -p akr-cli --test search"
            verified_by [ @akr.evidence.search-auto-refresh-suite/1 ]
        }
        check mcp-current {
            statement """
                knowledge.search inherits the current-index behavior through the shared CLI command path.
                """
            method command
            command "cargo test -p akr-mcp --test differential"
            verified_by [ @akr.evidence.search-auto-refresh-suite/1 ]
        }
        check no-rebuild-safe {
            statement """
                With --no-rebuild, search refuses a missing or stale cache with AKR-I031 and performs no cache write.
                """
            method command
            command "cargo test -p akr-cli --test search"
            verified_by [ @akr.evidence.search-auto-refresh-suite/1 ]
        }
    }
}

record akr.work.session-head-briefing/1 : work {
    title "Collate a session-head briefing in start"
    state superseded
    scope [
        path "crates/akr-cli/**",
        path "crates/akr-core/**",
        path "crates/akr-mcp/**",
        path "docs/**"
    ]
    intent """
        Make akr start and knowledge.start provide the next agent with a compact session-head
        handoff before task-specific matches: briefly identify the latest Git commit, focus the
        latest reachable AKR-linked work, collate all live planning branches and proposals,
        surface blockers and review risks, and clearly overlay valid uncommitted AKR changes or
        fall back to the validated committed snapshot.
        """
    acceptance {
        check bounded-deterministic {
            statement """
                The combined start response is stable, bounded, and reports deterministic omission
                counts when lower-priority detail does not fit.
                """
            method command
            command "cargo test --workspace --all-targets"
        }
        check combined-start {
            statement """
                CLI and MCP start responses share one deterministic handoff model while preserving
                the existing task-orientation fields.
                """
            method command
            command "cargo test -p akr-mcp --test differential"
        }
        check dirty-overlay {
            statement """
                A valid dirty ledger is shown as a semantic overlay and an invalid one falls back
                to a separately validated committed snapshot.
                """
            method command
            command "cargo test -p akr-cli --test commands"
        }
        check recent-focus {
            statement """
                The briefing shows HEAD and expands the latest reachable AKR-Work-linked branch,
                while collating every live planning branch and proposal.
                """
            method command
            command "cargo test -p akr-cli --test commands"
        }
    }
    implements [ @akr.decision.start-collates-session-head ]
}

